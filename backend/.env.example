# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_metrology

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:3000

# Public verification base URL
PUBLIC_BASE_URL=http://localhost:8000

# File upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Demo configuration (prototype settings - NOT legal requirements)
DEMO_CERTIFICATE_VALIDITY_DAYS=365
DEMO_REMINDER_WINDOWS_DAYS=30,7
DEMO_ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,application/pdf